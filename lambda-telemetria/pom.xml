<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.kafka.telemetria</groupId>
    <artifactId>lambda-telemetria</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>lambda-telemetria</name>
    <description>Lambdas de Conexiones y Procesador para el dashboard de operaciones en tiempo real</description>

    <!-- SIN spring-boot-starter-parent, a diferencia de los microservicios: una
         Lambda no levanta un contexto de Spring. Arrancar uno en cada invocacion
         multiplicaria el arranque en frio, que es justo lo que hay que cuidar
         en Java sobre Lambda. -->
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <aws.sdk.version>2.29.52</aws.sdk.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-core</artifactId>
            <version>1.2.3</version>
        </dependency>

        <!-- Trae DynamodbEvent, el tipo del evento de Streams. -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-lambda-java-events</artifactId>
            <version>3.14.0</version>
        </dependency>

        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>dynamodb</artifactId>
            <version>${aws.sdk.version}</version>
            <exclusions>
                <!-- Cada cliente del SDK arrastra Netty (para el cliente
                     asincrono) y Apache HttpClient. Aca todo es sincrono y se
                     usa url-connection-client, asi que los dos sobran: sacarlos
                     baja el jar de 16 MB a la mitad, y en Lambda el tamano del
                     artefacto se paga en cada arranque en frio. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- El cliente para empujar mensajes por una conexion de API Gateway.
             Es un artefacto aparte del de API Gateway "normal". -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>apigatewaymanagementapi</artifactId>
            <version>${aws.sdk.version}</version>
            <exclusions>
                <!-- Cada cliente del SDK arrastra Netty (para el cliente
                     asincrono) y Apache HttpClient. Aca todo es sincrono y se
                     usa url-connection-client, asi que los dos sobran: sacarlos
                     baja el jar de 16 MB a la mitad, y en Lambda el tamano del
                     artefacto se paga en cada arranque en frio. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Cliente HTTP sobre HttpURLConnection de la JDK: sin dependencias
             nativas y con el arranque mas corto de los tres que ofrece el SDK.
             Netty y Apache quedan excluidos en las dependencias de arriba. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
            <version>${aws.sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.18.2</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lambda necesita un jar con TODAS las dependencias adentro: no hay
                 resolucion de artefactos en tiempo de ejecucion. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <filters>
                        <filter>
                            <artifact>*:*</artifact>
                            <excludes>
                                <exclude>META-INF/*.SF</exclude>
                                <exclude>META-INF/*.DSA</exclude>
                                <exclude>META-INF/*.RSA</exclude>
                                <exclude>module-info.class</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <!-- El SDK v2 se apoya en archivos de servicio dentro de
                             META-INF/services: sin fusionarlos, el jar sombreado
                             falla en runtime al resolver el cliente HTTP. -->
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                    </transformers>
                </configuration>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
