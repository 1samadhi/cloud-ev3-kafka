# Host que los brokers ANUNCIAN a los clientes.
#   local -> localhost
#   AWS   -> IP publica de la EC2 (la cambia ./desplegar-aws.sh)
# Va SIN http:// y SIN puerto.
KAFKA_HOST=localhost

# Bootstrap que usan los microservicios. Los tres brokers, para que el cliente
# siga funcionando si uno se cae.
KAFKA_BOOTSTRAP=localhost:9092,localhost:9093,localhost:9094
