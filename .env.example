# Variables del compose de la raiz (docker-compose.yml).
# Copiar como .env:   cp .env.example .env

# Host que los brokers ANUNCIAN a los clientes que viven FUERA de la red de
# Docker (por ejemplo, un consumidor corriendo en el host).
#   local -> localhost
#   AWS   -> IP publica de la EC2
# Va SIN http:// y SIN puerto.
KAFKA_HOST=localhost

# Clave de root de MySQL. La usan el contenedor de la base y los dos servicios
# que persisten.
MYSQL_PASS=123456

# Endpoint WebSocket de API Gateway para la pantalla de Operaciones.
# Vacio es valido: la consola cae a leer directo de los microservicios.
WS_URL=
